{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"!src/**/*.test.ts",
				"!src/**/*.test.tsx",
				"!src/**/*.stories.ts",
				"!src/**/*.stories.tsx"
			],
			"outputs": ["dist/**"]
		},
		"test": {
			"inputs": ["src/**/*.test.ts", "src/**/*.test.tsx"]
		},
		"test:dist": {
			"dependsOn": ["build"],
			"inputs": ["dist-tests/**", "vite.config.mts"]
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"check": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"clean": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
