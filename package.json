{
	"name": "temporal-ui",
	"version": "0.10.2",
	"private": true,
	"description": "Monorepo for Temporal UI Design System (React, Solid bindings)",
	"license": "MIT",
	"author": "Temporal",
	"repository": {
		"type": "git",
		"url": "https://github.com/temprix-hq/temporal-ui.git"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"postinstall": "lefthook install",
		"build": "turbo run build",
		"clean": "turbo run clean && rimraf node_modules .turbo",
		"test": "turbo run test",
		"react": "cd packages/react && bun run storybook",
		"solid": "cd packages/solid && bun run storybook",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "turbo run typecheck",
		"check": "turbo run check",
		"changeset": "changeset",
		"version": "changeset version",
		"publish": "bun run build && node scripts/npm-publish.mjs",
		"ci:version": "changeset version && bun install",
		"ci:publish": "node scripts/npm-publish.mjs"
	},
	"devDependencies": {
		"@changesets/changelog-github": "0.5.1",
		"@changesets/cli": "2.29.8",
		"@temporal-ui/solid": "workspace:*",
		"@types/bun": "1.4.1",
		"@types/node": "25.9.1",
		"@typescript/native-preview": "7.0.0-dev.20260701.1",
		"jsdom": "29.1.1",
		"lefthook": "2.1.12",
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0",
		"rimraf": "6.1.3",
		"turbo": "2.10.12",
		"typescript": "6.0.3"
	},
	"packageManager": "bun@1.3.12",
	"trustedDependencies": [
		"@tailwindcss/oxide"
	]
}
