{
	"name": "@temporal-ui/solid",
	"version": "0.10.2",
	"description": "Solid.JS bindings for Temporal UI components",
	"bugs": {
		"url": "https://github.com/temprix-hq/temporal-ui/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/temprix-hq/temporal-ui.git",
		"directory": "packages/solid"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"module": "./dist/index.jsx",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"solid": "./dist/index.jsx",
			"default": "./dist/index.jsx"
		},
		"./hooks/*": {
			"types": "./dist/hooks/*/index.d.ts",
			"solid": "./dist/hooks/*/index.jsx",
			"default": "./dist/hooks/*/index.jsx"
		},
		"./utils/*": {
			"types": "./dist/utils/*/index.d.ts",
			"solid": "./dist/utils/*/index.jsx",
			"default": "./dist/utils/*/index.jsx"
		},
		"./*": {
			"types": "./dist/components/*/index.d.ts",
			"solid": "./dist/components/*/index.jsx",
			"default": "./dist/components/*/index.jsx"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown && node ../../scripts/copy-core-styles.mjs",
		"dev": "bun run storybook",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ci": "vitest run",
		"clean": "rimraf dist node_modules .turbo",
		"storybook": "storybook dev -p 6007",
		"build-storybook": "storybook build",
		"prepack": "node ../../scripts/replace-protocols.mjs",
		"postpublish": "node ../../scripts/restore-protocols.mjs"
	},
	"dependencies": {
		"@ark-ui/solid": "5.39.1",
		"@tanstack/solid-table": "8.21.3",
		"@temporal-ui/core": "workspace:*"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.3.1",
		"@solidjs/testing-library": "0.8.10",
		"@storybook/addon-a11y": "10.6.0",
		"@storybook/addon-docs": "10.6.0",
		"@storybook/addon-links": "10.6.0",
		"@storybook/addon-themes": "10.6.0",
		"@storybook/addon-vitest": "10.6.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/user-event": "14.6.7",
		"happy-dom": "20.14.0",
		"lucide-solid": "1.41.0",
		"storybook": "10.6.0",
		"storybook-solidjs-vite": "10.7.1",
		"tailwindcss": "4.3.3",
		"tsdown": "0.23.0",
		"vite": "8.2.2",
		"vite-plugin-solid": "2.11.14",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"solid-js": ">=1.0.0"
	}
}
